MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER/
MONGODB_DB=buildfest2026
APP_URL=http://localhost:3000
# Optional sole-admin restriction. Set both values together on the server.
ADMIN_EMAIL=
# bcrypt:<base64url-encoded bcrypt hash at cost 12>; avoids .env dollar expansion.
ADMIN_PASSWORD_HASH=
# Keep the plaintext password only in the ignored .env.local file.
# Do not use NEXT_PUBLIC_ prefixes or commit real credentials.
# Set these only when an official mail service is ready.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
